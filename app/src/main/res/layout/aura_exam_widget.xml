<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/exam_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aura_widget_bg">

    <ImageView
        android:id="@+id/exam_widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exam_widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aura_widget_pill_amber"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="AURA • EXAM RADAR"
                android:textColor="#FDE68A"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="" />

            <TextView
                android:id="@+id/exam_widget_summary_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/aura_widget_pill_glass"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="2 Upcoming"
                android:textColor="#E2F1FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Exam / Deadline Spotlight + Urgency Ring -->
        <LinearLayout
            android:id="@+id/exam_widget_spotlight"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:background="@drawable/aura_widget_inner_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="11dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/exam_widget_primary_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="CSCD 301 • Mid-Semester Exam"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/exam_widget_primary_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Great Hall Wing B • Seat 18"
                    android:textColor="#C8E2FF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/exam_widget_secondary_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Also due: MATH 304 Problem Set 3"
                    android:textColor="#93C5FD"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/exam_widget_ring_image"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/aura_exam_widget_description"
                android:scaleType="fitCenter"
                android:src="@drawable/aura_widget_ring_preview" />
        </LinearLayout>

        <!-- Action Dock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/exam_btn_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/aura_widget_action_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_exam" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Tasks"
                    android:textColor="#ECF6FF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exam_btn_mark_done"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="0.95"
                android:background="@drawable/aura_widget_action_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Done"
                    android:textColor="#34D399"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/exam_btn_war_room"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.15"
                android:background="@drawable/aura_widget_action_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_ai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="War Room"
                    android:textColor="#FDE68A"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
